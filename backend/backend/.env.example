# Copy this file to ".env" (same folder) and fill in the two Supabase values.
# NEVER put the service role / secret key in the Next.js app, and never commit ".env".

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY

# Websites allowed to call this API (comma separated). Add your Vercel URL when you deploy.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: requests allowed per minute (per IP for scans, per user for generating/revoking)
READ_RATE_LIMIT=60
TOKEN_RATE_LIMIT=20
